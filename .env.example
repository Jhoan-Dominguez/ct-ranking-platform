# Copia este archivo como .env (make create lo hace automáticamente).

# --- PostgreSQL (docker) ---
POSTGRES_USER=ctranking
POSTGRES_PASSWORD=ctranking
POSTGRES_DB=ctranking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Si se define, tiene prioridad sobre las variables POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://ctranking:ctranking@localhost:5432/ctranking

# --- Autenticación ---
# keycloak: login contra Keycloak (recomendado).  local: contraseñas bcrypt en PostgreSQL.
AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=ct-ranking
KEYCLOAK_CLIENT_ID=ct-ranking-app
KEYCLOAK_CLIENT_SECRET=ct-ranking-dev-secret
# Cliente que sólo verifica usuario y contraseña (paso 1 del login cuando hay 2FA).
# Lo crea scripts/configure_keycloak.py en `make up`.
KEYCLOAK_PWCHECK_CLIENT_ID=ct-ranking-pwcheck
KEYCLOAK_PWCHECK_CLIENT_SECRET=ct-ranking-pwcheck-dev-secret
# Credenciales de la consola de administración de Keycloak (http://localhost:8180).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Administrador de la plataforma (se crea en Keycloak y en la BD de la app).
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@ctranking.local
APP_ADMIN_PASSWORD=Admin123!

# --- Correo (SMTP) ---
# Desarrollo: Mailpit (docker compose) atrapa los correos -> http://localhost:8025
# Producción: cambia por tu SMTP real (p. ej. smtp.gmail.com:587 con SMTP_STARTTLS=true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=no-reply@ctranking.local
MAIL_FROM_NAME=CT Ranking
# Host SMTP visto desde el contenedor de Keycloak (nombre del servicio en docker compose).
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# URL pública de la app (enlaces en correos y redirecciones de Keycloak).
APP_URL=http://localhost:8501

# --- Cuentas ---
# Días de espera antes de eliminar definitivamente una cuenta.
ACCOUNT_DELETION_DAYS=7
# Dominio institucional obligatorio para el correo de los estudiantes.
STUDENT_EMAIL_DOMAIN=estudiantes.areandina.edu.co

# --- Inicio de sesión con Google (opcional, gratuito) ---
# Credenciales OAuth de Google Cloud Console (guía: docs/15-inicio-sesion-con-google.md).
# Vacío = el botón "Continuar con Google" no se muestra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secreto para firmar la cookie de sesión de Streamlit (st.login). Si queda vacío,
# scripts/write_streamlit_secrets.py genera uno aleatorio y lo guarda en .streamlit/secrets.toml.
AUTH_COOKIE_SECRET=

# --- Escala de calificaciones ---
GRADE_MIN=0
GRADE_MAX=5
GRADE_PASSING=3

# --- Streamlit ---
APP_PORT=8501
