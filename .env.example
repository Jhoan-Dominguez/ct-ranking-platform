# Copia este archivo como .env (make create lo hace automáticamente).

# --- PostgreSQL (docker) ---
POSTGRES_USER=ctranking
POSTGRES_PASSWORD=ctranking
POSTGRES_DB=ctranking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Si se define, tiene prioridad sobre las variables POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://ctranking:ctranking@localhost:5432/ctranking

# --- Autenticación ---
# keycloak: login contra Keycloak (recomendado).  local: contraseñas bcrypt en PostgreSQL.
AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=ct-ranking
KEYCLOAK_CLIENT_ID=ct-ranking-app
KEYCLOAK_CLIENT_SECRET=ct-ranking-dev-secret
# Credenciales de la consola de administración de Keycloak (http://localhost:8180).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Administrador de la plataforma (se crea en Keycloak y en la BD de la app).
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@ctranking.local
APP_ADMIN_PASSWORD=Admin123!

# --- Escala de calificaciones ---
GRADE_MIN=0
GRADE_MAX=5
GRADE_PASSING=3

# --- Streamlit ---
APP_PORT=8501
